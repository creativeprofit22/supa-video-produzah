{
  "name": "@supa-video/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run build:workspace-dependencies && pnpm run build:frontend",
    "build:workspace-dependencies": "pnpm --filter \"@supa-video/desktop...\" --filter \"!@supa-video/desktop\" build",
    "build:frontend": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && vite build",
    "check": "tsc -p tsconfig.json --pretty false && tsc -p tsconfig.node.json --pretty false && tsc -p tsconfig.browser.json --pretty false",
    "test": "vitest run --exclude \"browser-tests/**\"",
    "test:browser": "playwright test",
    "preview": "vite preview",
    "media:bootstrap:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/bootstrap-ffmpeg-windows.ps1",
    "media:verify:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/bootstrap-ffmpeg-windows.ps1 -VerifyOnly",
    "media:test:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/tests/bootstrap-ffmpeg-windows.Tests.ps1",
    "startup:benchmark:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ../../scripts/benchmark-packaged-startup-windows.ps1",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@supa-video/contracts": "workspace:*",
    "@supa-video/project": "workspace:*",
    "@supa-video/render": "workspace:*",
    "@tauri-apps/api": "2.11.1",
    "lucide-react": "1.26.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.0",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "axe-core": "4.12.1",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
